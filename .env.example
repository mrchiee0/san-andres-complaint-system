# ─── DATABASE (Railway MySQL) ─────────────────────────────────────────────────
# Copy these from your Railway project → MySQL service → Connect tab.
DB_HOST="your-railway-mysql-host.railway.app"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your-railway-db-password"
DB_NAME="railway"
# Set to "true" when connecting to Railway from outside (e.g. from Vercel).
DB_SSL="true"

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# A strong random secret for signing JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-strong-random-secret"

# ─── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# From Google Cloud Console → Credentials → OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# Also exposed to the browser (Vite VITE_ prefix).
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ─── GMAIL SMTP ───────────────────────────────────────────────────────────────
# Your Gmail address and an App Password (not your account password).
# Enable 2FA on Gmail then generate one at: myaccount.google.com/apppasswords
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"

# ─── GEMINI AI ────────────────────────────────────────────────────────────────
# Gemini API key for the AI chatbot (browser-side).
VITE_GEMINI_API_KEY="your-gemini-api-key"
# Optional: override the Gemini model (defaults to gemini-flash-lite-latest).
VITE_GEMINI_MODEL="gemini-flash-lite-latest"

# ─── CLOUDINARY (file uploads) ────────────────────────────────────────────────
# From Cloudinary dashboard → Settings → Access Keys.
# All uploaded files (evidence, documents, logo) are stored here.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ─── ABLY (real-time) ─────────────────────────────────────────────────────────
# Server-side Ably key (publish + subscribe). From Ably dashboard → Apps → API Keys.
ABLY_API_KEY="your-ably-api-key:your-ably-secret"
# Browser-side Ably key — should be a SEPARATE key scoped to subscribe-only.
# Create a second key in Ably dashboard with "Subscribe" capability only.
VITE_ABLY_API_KEY="your-ably-subscribe-only-key:secret"

# ─── APP ──────────────────────────────────────────────────────────────────────
# Set to "production" on Vercel — enables static file serving from dist/.
NODE_ENV="production"
# Port override (Vercel sets this automatically; only needed for local testing).
# PORT=3000
