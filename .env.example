# ─── DATABASE (Filess.io free MySQL) ──────────────────────────────────────────
# Sign up free at filess.io → Create Database → MySQL → copy the connection info.
# No credit card required. Free tier: 2 databases, 10MB storage, unlimited traffic.
DB_HOST="your-db.filess.io"
DB_PORT="3306"
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"
DB_NAME="your_db_name"
DB_SSL="true"          # Filess.io requires SSL — always keep this true

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Strong random secret for signing JWTs.
# On Render, this is auto-generated. For local dev: openssl rand -hex 32
JWT_SECRET="replace-with-a-strong-random-secret"

# ─── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# From Google Cloud Console → Credentials → OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ─── GMAIL SMTP ───────────────────────────────────────────────────────────────
# Enable 2FA on Gmail, then go to myaccount.google.com/apppasswords to generate.
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"

# ─── GEMINI AI ────────────────────────────────────────────────────────────────
VITE_GEMINI_API_KEY="your-gemini-api-key"
VITE_GEMINI_MODEL="gemini-flash-lite-latest"

# ─── CLOUDINARY (file uploads) ────────────────────────────────────────────────
# Sign up free at cloudinary.com → Dashboard → copy these 3 values.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ─── ABLY (real-time notifications) ───────────────────────────────────────────
# Sign up free at ably.com → App → API Keys.
# ABLY_API_KEY: default key (full publish+subscribe) — server side only.
# VITE_ABLY_API_KEY: a second key with Subscribe-only capability — browser side.
ABLY_API_KEY="your-ably-full-key:secret"
VITE_ABLY_API_KEY="your-ably-subscribe-only-key:secret"

# ─── APP ──────────────────────────────────────────────────────────────────────
NODE_ENV="production"
