# ─── DATABASE (Render MySQL private service) ──────────────────────────────────
# When deployed on Render, DB_HOST is set automatically from the MySQL private
# service internal hostname via render.yaml. For local dev, use localhost.
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="san_andres_complaint_system"
# Set to "true" only when connecting to an external managed DB (e.g. PlanetScale).
# On Render internal network, leave as "false" or unset.
DB_SSL="false"

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Strong random secret for signing JWTs.
# On Render, this is auto-generated via generateValue: true in render.yaml.
# For local dev, generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-strong-random-secret"

# ─── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# From Google Cloud Console → Credentials → OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# Also exposed to the browser (Vite VITE_ prefix required).
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ─── GMAIL SMTP ───────────────────────────────────────────────────────────────
# Your Gmail address and an App Password (NOT your account password).
# Enable 2FA on Gmail, then generate one at: myaccount.google.com/apppasswords
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"

# ─── GEMINI AI ────────────────────────────────────────────────────────────────
# Gemini API key for the AI chatbot (runs in the browser).
VITE_GEMINI_API_KEY="your-gemini-api-key"
# Optional: override the Gemini model (defaults to gemini-flash-lite-latest).
VITE_GEMINI_MODEL="gemini-flash-lite-latest"

# ─── CLOUDINARY (file uploads) ────────────────────────────────────────────────
# All uploaded files (evidence photos, disposition docs, site logo) go here.
# Sign up free at cloudinary.com → Dashboard → copy these 3 values.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ─── ABLY (real-time notifications) ───────────────────────────────────────────
# Server-side key (full publish + subscribe permissions).
# From Ably dashboard → Apps → API Keys → copy the default key.
ABLY_API_KEY="your-ably-api-key:your-ably-secret"
# Browser-side key — create a SEPARATE key in Ably with Subscribe-only capability.
# This prevents users from publishing arbitrary messages from the browser.
VITE_ABLY_API_KEY="your-ably-subscribe-only-key:secret"

# ─── APP ──────────────────────────────────────────────────────────────────────
# Set to "production" on Render — enables static file serving from dist/.
# Render sets this automatically; only needed for local production testing.
NODE_ENV="production"
